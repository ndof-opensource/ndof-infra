# Team profile: Linux + GCC 14, C++23.
# The image is multi-arch (amd64/arm64); arch is resolved at render time.
{% set arch = "armv8" if platform.machine() in ["arm64", "aarch64"] else "x86_64" %}

[settings]
os=Linux
arch={{ arch }}
build_type=Release
compiler=gcc
compiler.version=14
compiler.libcxx=libstdc++11
compiler.cppstd=23

[conf]
tools.cmake.cmaketoolchain:generator=Ninja
tools.build:compiler_executables={"c": "gcc-14", "cpp": "g++-14"}
